msgid "plugins.block.vlibras.displayName"
msgstr "Bloc VLibras (langue des signes brésilienne)"

msgid "plugins.block.vlibras.description"
msgstr "Intègre le widget VLibras (le traducteur du gouvernement brésilien du portugais vers la langue des signes Libras) afin que les lecteurs sourds puissent traduire le contenu de la revue."

msgid "plugins.block.vlibras.title"
msgstr "Libras"

msgid "plugins.block.vlibras.text"
msgstr "Traduisez ce contenu en langue des signes brésilienne (Libras) à l'aide de l'avatar VLibras affiché à l'écran."
