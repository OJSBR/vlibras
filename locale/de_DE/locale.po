msgid "plugins.block.vlibras.displayName"
msgstr "VLibras-Block (brasilianische Gebärdensprache)"

msgid "plugins.block.vlibras.description"
msgstr "Bindet das VLibras-Widget ein (der Portugiesisch-zu-Libras-Übersetzer der brasilianischen Regierung), damit gehörlose Leserinnen und Leser die Inhalte der Zeitschrift übersetzen können."

msgid "plugins.block.vlibras.title"
msgstr "Libras"

msgid "plugins.block.vlibras.text"
msgstr "Übersetzen Sie diesen Inhalt mit dem auf dem Bildschirm angezeigten VLibras-Avatar in die brasilianische Gebärdensprache (Libras)."
