msgid "plugins.block.vlibras.displayName"
msgstr "Bloque VLibras (lengua de señas brasileña)"

msgid "plugins.block.vlibras.description"
msgstr "Integra el widget de VLibras (el traductor de portugués a Libras del gobierno de Brasil) para que las personas sordas puedan traducir el contenido de la revista."

msgid "plugins.block.vlibras.title"
msgstr "Libras"

msgid "plugins.block.vlibras.text"
msgstr "Traduzca este contenido a la lengua de señas brasileña (Libras) usando el avatar de VLibras que aparece en la pantalla."
